name: scanbite
description: AI Food Nutrition Scanner
publish_to: 'none'
version: 1.0.1+40

environment:
  sdk: '>=3.0.0 <4.0.0'

dependencies:
  flutter:
    sdk: flutter
  flutter_localizations:
    sdk: flutter
  flutter_image_compress: ^2.1.0  # ADD THIS
  firebase_app_check: 0.4.1+3

  # Firebase
  firebase_core: ^4.4.0
  firebase_auth: ^6.1.4
  cloud_firestore: ^6.1.2
  firebase_storage: ^13.0.6


  flutter_local_notifications:
  timezone: ^0.9.4



  # OpenAI
  http: ^1.1.0
  dart_openai: ^6.1.1

  # Image Handling
  image_picker: ^1.0.5
  camera: ^0.11.4
  path_provider: ^2.1.1
  path: ^1.8.3
  hive: ^2.2.3
  hive_flutter: ^1.1.0

  # Barcode Scanner
  mobile_scanner: ^7.1.4

  # UI/UX
  google_fonts: ^6.3.3
  flutter_svg: ^2.0.9
  cached_network_image: ^3.3.0
  shimmer: ^3.0.0
  fl_chart: ^1.1.1
  intl: ^0.20.2
  share_plus: ^10.0.2


  # In-App Purchases
  in_app_purchase: ^3.2.0
  in_app_review: ^2.0.8

  # State Management
  provider: ^6.1.1

  # Utils
  shared_preferences: ^2.2.2
  uuid: ^4.2.2
  image: ^4.7.2

  # ADD THESE FOR BILLING
  in_app_purchase_android: ^0.3.0+16

  cupertino_icons: ^1.0.6


  # URL Launcher
  url_launcher: ^6.2.3
  cloud_functions: ^6.0.6

dev_dependencies:
  flutter_test:
    sdk: flutter
  flutter_launcher_icons: ^0.13.1  # ADD THIS

flutter:
  uses-material-design: true
  generate: true


  # assets:
  #  - .env
  #  - assets/images/

  # Uncomment when you add actual assets
  # assets:
  #   - assets/images/
  #   - assets/icons/

# Uncomment and configure when you have an app icon ready
flutter_launcher_icons:
  android: true
  ios: true
  image_path: "assets/icon/app_icon.png"
  adaptive_icon_background: "#FF6F00"
  adaptive_icon_foreground: "assets/icon/app_icon.png"
  remove_alpha_ios: true


